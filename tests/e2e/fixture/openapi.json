{
  "openapi": "3.1.0",
  "info": { "title": "Profile API", "version": "1.0.0" },
  "paths": {
    "/api/profile": {
      "get": {
        "responses": {
          "200": {
            "description": "The profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["name", "email"],
                  "properties": {
                    "name": { "type": "string" },
                    "email": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}

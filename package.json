{
  "name": "mokapi-storybook-addon",
  "version": "0.0.0",
  "description": "Switch Storybook between MSW and Mokapi contract validation",
  "homepage": "https://mokapi.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marle3003/mokapi-storybook-addon.git"
  },
  "bugs": {
    "url": "https://github.com/marle3003/mokapi-storybook-addon/issues"
  },
  "keywords": [
    "mokapi",
    "storybook",
    "storybook-addon",
    "msw",
    "mock service worker",
    "api mocking",
    "openapi"
  ],
  "author": "Marcel Lehmann",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests --ext .ts,.tsx,.mjs",
    "test:e2e": "node --test tests/e2e.mjs",
    "check": "npm run build && npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "go-mokapi": "0.56.0",
    "mokapi-msw-adapter": "0.1.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.0.0"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./msw": { "types": "./dist/msw.d.ts", "import": "./dist/msw.js", "default": "./dist/msw.js" },
    "./preset": { "types": "./dist/preset.d.ts", "import": "./dist/preset.js", "default": "./dist/preset.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "peerDependencies": {
    "storybook": "^10.6.4",
    "msw": "^2.15.0",
    "vite": ">=6",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "msw": { "optional": true }
  },
  "storybook": { "displayName": "Mokapi" }
}
